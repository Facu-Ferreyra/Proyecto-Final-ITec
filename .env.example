# Base de datos (Neon)
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"
DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Auth
JWT_SECRET="PENDIENTEEEEEEEEEEEE"
JWT_EXPIRES_IN="1d"

# App
NODE_ENV="development"
PORT=3000
CLIENT_URL="http://localhost:5173"

# Seed: contraseñas de los usuarios de prueba (admin@easybot.com y usuario@easybot.com).
# Mínimo 8 caracteres, con al menos una letra y un número.
SEED_ADMIN_PASSWORD="cambiar-por-una-contraseña-1"
SEED_USER_PASSWORD="cambiar-por-una-contraseña-2"
# Frontend (Vite las lee al compilar: en local van en client/.env; en Render, como
# variables de entorno del servicio). Solo las que empiezan con VITE_ llegan al navegador.
# VITE_CONTACT_EMAIL: contacto que muestra /privacidad para pedir ver o borrar datos.
# VITE_SITE_URL: URL pública para las etiquetas OpenGraph (en Render no hace falta).
VITE_CONTACT_EMAIL=""
VITE_SITE_URL=""
